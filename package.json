{
  "name": "open-whispr",
  "version": "1.7.2",
  "description": "Windows dictation app with local whisper.cpp and llama formatting",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:winpaste": "node scripts/build-windows-fast-paste.js",
    "compile:native": "npm run compile:winkeys && npm run compile:winpaste",
    "prestart": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:formatting-model",
    "start": "electron .",
    "predev": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:formatting-model",
    "dev": "concurrently -k -r npm:dev:renderer npm:dev:main",
    "predev:main": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "prebuild:win": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:nircmd && npm run download:windows-fast-paste && npm run download:windows-key-listener",
    "build:win": "npm run build:renderer && electron-builder --win",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.js --current",
    "download:llama-server": "node scripts/download-llama-server.js --current",
    "download:formatting-model": "node scripts/download-formatting-model.js",
    "download:whisper-model": "node scripts/download-whisper-model.js large-v3-turbo",
    "download:nircmd": "node scripts/download-nircmd.js",
    "download:windows-fast-paste": "node scripts/download-windows-fast-paste.js",
    "download:windows-key-listener": "node scripts/download-windows-key-listener.js",
    "test:formatting": "node scripts/test-local-formatting.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write .",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check .",
    "lint": "eslint . && cd src && eslint .",
    "typecheck": "cd src && tsc --noEmit",
    "preview": "cd src && vite preview"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "OpenWhispr Team",
    "email": "support@openwhispr.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.4.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^26.0.4",
    "lucide-react": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.2",
    "tailwind-merge": "^3.3.1",
    "unzipper": "^0.12.3"
  }
}
